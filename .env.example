# Altcha Server Configuration

# HMAC secret for token signing (leave empty for auto-generation)
ALTCHA_SECRET=

# Default PoW difficulty level (1-4, default: 2)
ALTCHA_DIFFICULTY_DEFAULT=2

# CORS origin restriction (empty to allow all origins)
ALTCHA_CORS_ORIGIN=

# Server port (default: 8080)
PORT=8080
